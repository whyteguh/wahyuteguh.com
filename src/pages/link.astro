---
import Base from '../layouts/Base.astro';
import { socials } from '../lib/site';

// Add new buttons here — they render in order.
const links = [
  { label: 'Surat Langit', href: '/suratlangit', special: true },
  { label: 'Moslem Productivity Rhythm', href: '/resources/moslem-productivity-rhythm/' },
  { label: 'More Resources', href: '/resources/' },
  { label: 'YouTube', href: 'https://www.youtube.com/@whyteguh' },
];
---
<Base title="wahyuteguh — links" description="All my links in one place." centered>
  <div class="sec bio">
    <div class="note">start here ↴</div>

    <img class="bio-logo" src="/favicon.png" alt="wt" />

    <h1 class="bio-name">wahyuteguh</h1>
    <p class="bio-intro">Let's try to figure out how intelligence, business, and kindness can work together, together :).</p>

    <div class="bio-links">
      {links.map((l) =>
        l.special ? (
          <a class="bio-btn sl-btn" href={l.href}>
            <svg class="env" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2.5" y="5" width="19" height="14" rx="2.5" fill="rgba(227,184,115,0.14)" />
              <path d="m3 6.5 9 6.5 9-6.5" />
            </svg>
            <span>{l.label}</span>
          </a>
        ) : (
          <a
            class="bio-btn"
            href={l.href}
            target={l.href.startsWith('http') ? '_blank' : undefined}
            rel={l.href.startsWith('http') ? 'noopener' : undefined}
          >
            <span class="e">{l.emoji}</span>
            {l.label}
          </a>
        )
      )}
    </div>

    <div class="social-row bio-socials">
      {socials.map((s) => (
        <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel={s.href.startsWith('http') ? 'noopener' : undefined}>
          {s.label}
        </a>
      ))}
    </div>
  </div>
</Base>

<style is:global>
  .bio {
    align-items: center;
    text-align: center;
    gap: 16px;
  }
  .bio-logo {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px dashed var(--dotline);
    padding: 4px;
    background: #fff;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
    transform: rotate(-2.5deg);
  }
  .bio-name {
    margin: 6px 0 0;
    font-size: 26px;
    font-weight: 700;
    font-family: var(--font-body);
  }
  .bio-intro {
    margin: 0;
    font-size: calc(13.5px * var(--fsx));
    line-height: 1.8;
    color: var(--muted);
    max-width: 420px;
  }
  .bio-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 420px;
    margin-top: 10px;
  }
  .bio-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid var(--faint);
    background: var(--card);
    padding: 14px 18px;
    font-size: calc(14px * var(--fsx));
    font-weight: 700;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.12s ease;
  }
  .bio-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: rotate(-0.5deg);
  }
  /* Surat Langit — dark starry-night button */
  .sl-btn {
    color: #ffe4b0;
    border-color: rgba(227, 184, 115, 0.35);
    background:
      radial-gradient(1.4px 1.4px at 18% 30%, #ffe4b0, transparent),
      radial-gradient(1px 1px at 44% 72%, #ffe4b0, transparent),
      radial-gradient(1.6px 1.6px at 68% 18%, #ffe4b0, transparent),
      radial-gradient(1px 1px at 84% 58%, #ffe4b0, transparent),
      radial-gradient(1.2px 1.2px at 30% 88%, #ffe4b0, transparent),
      radial-gradient(1px 1px at 58% 46%, #ffe4b0, transparent),
      radial-gradient(1.3px 1.3px at 11% 58%, #ffe4b0, transparent),
      radial-gradient(1px 1px at 93% 82%, #ffe4b0, transparent),
      radial-gradient(1.5px 1.5px at 76% 78%, #ffe4b0, transparent),
      radial-gradient(ellipse at 50% 0%, #2b2a55 0%, #12132a 72%);
    background-size: 100% 100%;
    position: relative;
    overflow: hidden;
  }
  .sl-btn .env {
    color: #e3b873;
    filter: drop-shadow(0 0 5px rgba(227, 184, 115, 0.75));
  }
  .sl-btn:hover {
    color: #fff;
    border-color: rgba(227, 184, 115, 0.85);
    box-shadow: 0 0 20px rgba(227, 184, 115, 0.28);
    transform: rotate(-0.5deg);
  }
  .sl-btn:hover .env {
    filter: drop-shadow(0 0 9px rgba(227, 184, 115, 1));
  }
  .bio-socials {
    justify-content: center;
    margin-top: 14px;
    padding-top: 16px;
    border-top: 1px dashed var(--dotline);
    width: 100%;
    max-width: 420px;
  }
</style>

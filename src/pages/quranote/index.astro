---
const title = 'Quranote';
const description = 'Baca Al-Qur\'an dengan terjemahan berdampingan, catat tiap ayat, dan hubungkan jadi knowledge graph — data tetap di perangkatmu.';
const appUrl = 'https://quranote.wahyuteguh.com/';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#059669" />
    <style>
      html, body, iframe { width: 100%; height: 100%; }
      html, body { margin: 0; overflow: hidden; background: #fbfaf6; }
      iframe { display: block; border: 0; }
    </style>
  </head>
  <body>
    <iframe src={appUrl} title={title} allow="clipboard-write"></iframe>
  </body>
</html>
